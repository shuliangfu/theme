{
  "name": "@dreamer/theme",
  "version": "1.0.1",
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "tasks": {
    "test": "deno test --allow-all tests/",
    "test:browser": "deno test --allow-all tests/browser/",
    "check": "deno check src/mod.ts",
    "publish": "deno publish"
  },
  "imports": {
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.1.6",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.18",
    "@dreamer/test": "jsr:@dreamer/test@^1.0.15"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.window"
    ]
  }
}
