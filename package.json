{
  "name": "@dreamer/theme",
  "version": "1.1.0",
  "description": "Theme utilities for Deno, Bun and Node.js.",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts"
  },
  "scripts": {
    "test": "bun test tests/theme.test.ts",
    "test:browser": "bun test tests/browser/",
    "test:node": "tsx --tsconfig tsconfig.json --test --test-force-exit tests/theme.test.ts",
    "check": "deno check src/mod.ts"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.2.3",
    "tsx": "^4.19.2"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "keywords": [
    "theme",
    "dreamer"
  ]
}
